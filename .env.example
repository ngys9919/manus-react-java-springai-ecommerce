# ---------------------------------------------------------------------------
# Shopwise environment template
#
# Copy to .env and fill in. .env is git-ignored; this file is not.
# The backend reads these through Spring's ${VAR:default} placeholders, so every
# value below is optional for a local run and required for a real deployment.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
SHOPWISE_DB_URL=jdbc:postgresql://localhost:5432/shopwise
SHOPWISE_DB_USER=shopwise
SHOPWISE_DB_PASSWORD=change-me

# --- Session signing --------------------------------------------------------
# Required outside local development: the application refuses to start with the
# development placeholder once a non-local profile is active.
# Generate one with:  openssl rand -base64 48
SHOPWISE_JWT_SECRET=

# --- Browser origins --------------------------------------------------------
# Origins allowed to call the API. The defaults cover local development, and
# same-origin requests are accepted automatically - but a proxy that rewrites
# the Host header (Vite's changeOrigin, most reverse proxies) makes that check
# impossible to evaluate, because the backend only ever sees the proxy's target
# while the browser sends the public hostname. Any deployment on a hostname it
# cannot otherwise learn must declare it here, wildcards allowed:
#   SHOPWISE_ALLOWED_ORIGIN_PATTERNS=https://*.example.com,http://localhost:[*]
# Symptom when it is missing: the storefront loads, then every POST fails with
# 403 "Invalid CORS request" - which the browser can only report as an opaque
# error. The backend log names the rejected origin and the Host it saw.
SHOPWISE_ALLOWED_ORIGIN_PATTERNS=

# --- Model access -----------------------------------------------------------
# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
SHOPWISE_AI_MODEL=gpt-5-mini

# --- Assistant --------------------------------------------------------------
SHOPWISE_ASSISTANT_ENABLED=true

# --- Server -----------------------------------------------------------------
SERVER_PORT=8080

# --- Frontend (Vite) --------------------------------------------------------
# Where the dev/preview server proxies /api
VITE_BACKEND_URL=http://localhost:8080
# Comma-separated host allowlist for the Vite server. Leave unset to allow any host,
# which is convenient in a sandbox and wrong in production.
# SHOPWISE_ALLOWED_HOSTS=shop.example.com,www.shop.example.com

# ---------------------------------------------------------------------------
# Docker Compose
# Used by docker-compose.yml. See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Host port the storefront is published on.
SHOPWISE_HTTP_PORT=8080

# Database name (the user and password above are reused by the postgres service).
SHOPWISE_DB_NAME=shopwise

# JVM flags for the backend container. MaxRAMPercentage scales the heap to the
# container's memory limit, so set a limit and let the JVM adapt.
SHOPWISE_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# Frontend container: the port nginx listens on and the backend it proxies to.
# The defaults suit docker-compose.yml; docker-compose.host-network.yml
# overrides both.
SHOPWISE_LISTEN_PORT=80
SHOPWISE_API_UPSTREAM=backend:8080
